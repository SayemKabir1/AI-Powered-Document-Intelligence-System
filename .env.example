DEMO_MODE=false
# Copy to .env for the production Compose stack. Use long, unique random values.
POSTGRES_DB=docintel
POSTGRES_USER=docintel
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-at-least-24-random-characters
CORS_ORIGINS=https://your-approved-hostname.example
MAX_UPLOAD_MB=50
UPLOAD_REQUEST_MB=100
UPLOAD_CONCURRENCY=4
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
WORKER_LEASE_TIMEOUT_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
