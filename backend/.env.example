# Local development only. Copy to backend/.env; do not commit the resulting file.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./document_intelligence.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
UPLOAD_REQUEST_MB=100
UPLOAD_CONCURRENCY=4
MAX_PDF_PAGES=1200
MAX_IMAGE_PIXELS=50000000
MAX_SPREADSHEET_ROWS=200000
MAX_SPREADSHEET_SHEETS=100
OCR_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-before-use
BOOTSTRAP_TOKEN=replace-with-a-long-random-token-before-use
SESSION_TTL_SECONDS=43200
MIN_SEMANTIC_SIMILARITY=0.55
RATE_LIMIT_PER_MINUTE=120
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=12
WORKER_POLL_SECONDS=0.75
WORKER_RETRY_DELAY_SECONDS=2
WORKER_LEASE_TIMEOUT_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
